{
    "name": "react-kithooks",
    "version": "1.10.12",
    "description": "react-kithooks: a TypeScript-first kit of production-grade React hooks — scroll anchoring, keyboard shortcuts, permissions, crash-safe form drafts, multi-tab storage sync, real online status, and race-free async (fetch, queue, polling, debounce, throttle). Zero dependencies, SSR-safe.",
    "license": "MIT",
    "sideEffects": false,
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./useFormCrashRecovery/rhf": {
            "import": {
                "types": "./dist/useFormCrashRecovery/rhf.d.ts",
                "default": "./dist/useFormCrashRecovery/rhf.js"
            },
            "require": {
                "types": "./dist/useFormCrashRecovery/rhf.d.cts",
                "default": "./dist/useFormCrashRecovery/rhf.cjs"
            }
        },
        "./use*": {
            "import": {
                "types": "./dist/use*/index.d.ts",
                "default": "./dist/use*/index.js"
            },
            "require": {
                "types": "./dist/use*/index.d.cts",
                "default": "./dist/use*/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "typesVersions": {
        "*": {
            "useFormCrashRecovery/rhf": [
                "./dist/useFormCrashRecovery/rhf.d.ts"
            ],
            "use*": [
                "./dist/use*/index.d.ts"
            ]
        }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsup && node scripts/add-use-client.mjs",
        "dev": "tsup --watch --onSuccess \"node scripts/add-use-client.mjs\"",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "check-exports": "publint && attw --pack .",
        "size": "size-limit",
        "pack:verify": "npm pack --dry-run",
        "changeset": "changeset",
        "release": "npm run build && node scripts/publish-if-new.mjs",
        "prepare": "husky"
    },
    "peerDependencies": {
        "react": ">=18",
        "react-hook-form": ">=7"
    },
    "peerDependenciesMeta": {
        "react-hook-form": {
            "optional": true
        }
    },
    "keywords": [
        "react",
        "hooks",
        "kithooks",
        "react-kithooks",
        "react-hooks",
        "hooks-library",
        "typescript",
        "scroll-anchor",
        "chat-scroll",
        "permissions",
        "keyboard-shortcuts",
        "hotkeys",
        "focus-trap",
        "focus-management",
        "accessibility",
        "a11y",
        "modal",
        "dialog",
        "indexeddb",
        "form-recovery",
        "form-persist",
        "local-storage",
        "session-storage",
        "multi-tab",
        "storage-sync",
        "online-status",
        "network-status",
        "tab-leader",
        "leader-election",
        "web-locks",
        "idle",
        "idle-timer",
        "session-timeout",
        "user-activity",
        "fetch",
        "abort-controller",
        "race-condition",
        "async-queue",
        "polling",
        "interval",
        "backoff",
        "mutex",
        "serialize-requests",
        "single-flight",
        "double-click",
        "submit-guard",
        "debounce",
        "throttle",
        "requestanimationframe",
        "scroll-handler",
        "media-query",
        "responsive",
        "use-previous"
    ],
    "author": "Pavel Lazarchuk",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/PavelLazarchuk/react-kithooks.git"
    },
    "bugs": {
        "url": "https://github.com/PavelLazarchuk/react-kithooks/issues"
    },
    "homepage": "https://github.com/PavelLazarchuk/react-kithooks#readme",
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@changesets/cli": "^2.31.1",
        "@eslint/js": "^10.0.1",
        "@size-limit/preset-small-lib": "^13.0.3",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitest/coverage-v8": "^4.1.11",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "fake-indexeddb": "^6.2.5",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "lint-staged": "^17.4.1",
        "prettier": "^3.9.6",
        "publint": "^0.3.24",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-hook-form": "^7.86.0",
        "size-limit": "^13.0.3",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.68.0",
        "vitest": "^4.1.11"
    },
    "overrides": {
        "tsup": {
            "esbuild": "^0.28.2"
        }
    }
}
